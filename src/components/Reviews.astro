---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const r = messages.reviews;
const hero = messages.hero;
const stars = (n: number) => Array.from({ length: 5 }, (_, i) => i < n ? 'star-filled' : 'star-empty');
const ratingNum = Number(String(hero.rating).replace(/[^0-9.]/g, '')) || 4.1;
const ratingStars = Math.round(ratingNum);
const featured = r.featured ?? [];
---

<section id="reviews" class="section-padding" style="background: var(--bg-primary);">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3 text-center" style="color: var(--text-primary);">{r.title}</h2>
    <p class="text-center text-base mb-10" style="color: var(--text-secondary);">{r.declaration}</p>

    <!-- Aggregate snapshot (Google Maps rating, not individual testimonials) -->
    <div class="rounded-2xl p-8 border text-center mb-10" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
      <div class="flex items-center justify-center gap-1 text-3xl mb-2" style="color: var(--accent);">
        {stars(ratingStars).map((c) => <span class={c}>★</span>)}
      </div>
      <p class="font-display text-2xl font-semibold" style="color: var(--text-primary);">{hero.rating}</p>
      <p class="text-sm mt-1" style="color: var(--text-muted);">{hero.reviewCount}{r.aggregateNote ? ` · ${r.aggregateNote}` : ''}</p>
      <div class="mt-5">
        <a href={r.mapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex w-full sm:w-auto justify-center px-8 py-3 rounded-full font-semibold text-white" style="background: var(--accent);">
          📍 {r.moreReviews}
        </a>
      </div>
    </div>

    {featured.length > 0 && (
      <div class="grid md:grid-cols-3 gap-6">
        {featured.map((item) => (
          <blockquote class="rounded-2xl p-6 border" style="background: var(--bg-tertiary); border-color: var(--border-color);">
            <p class="text-base leading-relaxed" style="color: var(--text-secondary);">“{item.text}”</p>
            <footer class="mt-4 text-xs" style="color: var(--text-muted);">— {item.source}</footer>
          </blockquote>
        ))}
      </div>
    )}
  </div>
</section>
