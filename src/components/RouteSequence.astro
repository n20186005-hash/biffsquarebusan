---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const rt = messages.higashiyamaRoute;
const steps = rt.steps ?? [];
---

<section id="route" class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-6xl mx-auto px-4">
    <div class="max-w-3xl mx-auto text-center mb-12">
      <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3" style="color: var(--text-primary);">{rt.title}</h2>
      <p class="text-base sm:text-lg leading-relaxed" style="color: var(--text-secondary);">{rt.subtitle}</p>
    </div>

    <div class="max-w-4xl mx-auto">
      <div class="relative">
        <!-- connecting line -->
        <div class="hidden sm:block absolute top-0 bottom-0 left-[27px] w-0.5" style="background: color-mix(in srgb, var(--accent) 30%, transparent);"></div>

        <ol class="space-y-6">
          {steps.map((s, i) => (
            <li class="relative flex gap-5 items-start">
              <div class="shrink-0 relative z-10 w-14 h-14 rounded-2xl flex items-center justify-center text-lg font-bold shadow-sm" style="background: var(--accent); color: #fff;">
                {String(i + 1).padStart(2, '0')}
              </div>
              <div class="min-w-0 flex-1 rounded-2xl p-5 sm:p-6 border" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <p class="font-semibold text-lg leading-snug" style="color: var(--text-primary);">{s.title}</p>
                  {s.meta && <span class="text-xs font-medium px-2.5 py-1 rounded-full whitespace-nowrap" style="background: color-mix(in srgb, var(--accent) 14%, transparent); color: var(--accent);">{s.meta}</span>}
                </div>
                {s.text && <p class="text-base leading-relaxed mt-2" style="color: var(--text-secondary);">{s.text}</p>}
                {s.tips && (
                  <ul class="mt-3 space-y-2 text-sm" style="color: var(--text-secondary);">
                    {s.tips.map((tip) => (
                      <li class="flex gap-3"><span style="color: var(--accent);">•</span><span>{tip}</span></li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>

      {rt.disclaimer && (
        <p class="max-w-4xl mx-auto mt-8 text-xs leading-relaxed" style="color: var(--text-muted);">{rt.disclaimer}</p>
      )}
    </div>
  </div>
</section>
